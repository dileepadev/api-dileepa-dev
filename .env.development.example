# Development configuration for api.dileepa.dev (v2.0.0, FastAPI).
#
#   cp .env.development.example .env.development
#
# This file is complete on its own. `ENVIRONMENT=development` loads it and
# nothing else — there is no shared base file and no local override file, so
# the value you read here is the value in effect. Real environment variables
# still win, which is how you override one for a single command:
#
#   MONGODB_DB=scratch uv run fastapi dev
#
# Its production counterpart is .env.production.example. The two overlap on
# purpose: duplication is the price of never having to work out which file won.
#
# Real .env.* files are gitignored. Only these *.example templates are
# committed, and they must never carry a real value.

# --- Application ---------------------------------------------------------
# Must match the file name. ENVIRONMENT is read from the process environment to
# decide which file to load, so setting it to anything else here makes the app
# refuse to start rather than load the wrong cluster's credentials.
ENVIRONMENT=development
PORT=8000
# Used to compose blog canonical URLs.
SITE_URL=http://localhost:3000

# The Scalar bundle the reference page loads. Pin a version, or point it at a
# self-hosted copy; whatever origin is set here is the only one the docs page's
# Content-Security-Policy allows.
# SCALAR_JS_URL=https://cdn.jsdelivr.net/npm/@scalar/api-reference

# The API reference at /docs and the OpenAPI JSON at /api-json are on by
# default outside production. Set false to rehearse the production posture
# locally, which is worth doing before a release.
# DOCS_ENABLED=false

# --- CORS ----------------------------------------------------------------
# Comma-separated allowlist. Never `*`. localhost:3000, :3001, :3002 and :4321
# are added automatically outside production, so this only needs the extras —
# a phone on the LAN, a tunnel.
CORS_ORIGINS=

# --- MongoDB -------------------------------------------------------------
# Development gets its own database. The same cluster is fine; the same
# database is not — the scripts in scripts/ rewrite documents in place, and a
# dry run against production data is only safe by accident.
MONGODB_URI=mongodb://localhost:27017/dileepa
# Only needed when the URI has no default database in its path.
MONGODB_DB=dev

# --- Auth ----------------------------------------------------------------
# JWT_SECRET, JWT_ALGORITHM and ACCESS_TOKEN_EXPIRE_MINUTES must match the
# NestJS deployment through the cutover, or every existing session is
# invalidated the moment traffic moves. Generate a new secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cloudinary ----------------------------------------------------------
# The only image backend. Azure Blob Storage is retired. Leave these empty and
# uploads return 503, which is a correct answer rather than a broken endpoint.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=api-dileepa-dev-dev

# --- Contact form (Resend) -----------------------------------------------
# POST /contact sends a real email when this key is set. Leave it empty while
# working through http/contact.http unless you mean to send one.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_EMAIL=contact@dileepa.dev

# --- Blog sync -----------------------------------------------------------
# Machine-to-machine key for POST /blogs/sync, sent as an x-api-key header by
# the blog repo's workflow. Same variable name as v1.
BLOG_SYNC_API_KEY=dev_blog_sync_key

# --- Rate limits ---------------------------------------------------------
# slowapi notation. Loosened here so hand-testing through http/ does not trip
# the limiter; .env.production carries the real numbers.
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_CONTACT=30/minute
