# About — the single about record.
#
# Unlike every other resource this one is a singleton: there is no id in the
# path, and a second POST is a 409 rather than a second row.

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

###

@accessToken = {{login.response.body.$.access_token}}

### Read it. Public. 404 until one exists.
GET {{baseUrl}}/about

### Create it.
POST {{baseUrl}}/about
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Dileepa Bandara",
  "title": "Software Engineer",
  "tagline": "Building things for the web",
  "taglineDescription": "The sentence under the tagline in the hero.",
  "description": [
    "First paragraph of the about text.",
    "Second paragraph."
  ],
  "shortBio": "Dileepa Bandara is an AI engineer building agentic systems, production LLM pipelines, and the developer communities around them.",
  "fullBio": "Dileepa Bandara is an AI systems engineer with experience building agentic applications, production evaluation harnesses, and scalable cloud solutions. A community builder and active technical speaker, he has delivered talks and hands-on workshops across developer meetups, conferences, and open-source groups.",
  "status": "Open to opportunities",
  "images": {
    "bannerWebp": "https://res.cloudinary.com/example/banner.webp",
    "profilePng": "https://res.cloudinary.com/example/profile.png",
    "profileWebp": "https://res.cloudinary.com/example/profile.webp",
    "profileJpg": "https://res.cloudinary.com/example/profile.jpg"
  },
  "links": {
    "website": "https://dileepa.dev",
    "email": "contact@dileepa.dev",
    "github": "https://github.com/dileepadev",
    "linkedin": "https://linkedin.com/in/dileepadev",
    "xtwitter": "https://x.com/dileepadev",
    "instagram": "",
    "youtube": "",
    "facebook": null
  },
  "connect": ["email", "github", "linkedin"]
}

### A second create -> 409 conflict, pointing at PATCH.
POST {{baseUrl}}/about
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Duplicate",
  "title": "Duplicate",
  "tagline": "Duplicate",
  "description": ["x"],
  "status": "x",
  "images": {},
  "links": {},
  "connect": []
}

### Update it. Send only what changes.
PATCH {{baseUrl}}/about
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "tagline": "Building things for the web, mostly in Python"
}

### The hero, in one record. `tagline` is the display heading and
# `taglineDescription` the line under it, so the site reads both from the
# response it already has rather than making a second request for the second
# half of the same sentence.
PATCH {{baseUrl}}/about
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "tagline": "Building things for the web, mostly in Python",
  "taglineDescription": "Backends, the tools around them, and notes on how it went."
}

### The two speaker biographies. The media kit at /profile copies these
# verbatim, so they are written as the organiser will paste them — third
# person, no markup, and short enough to sit in a conference agenda.
PATCH {{baseUrl}}/about
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "shortBio": "Dileepa Bandara is an AI engineer building agentic systems and the developer communities around them.",
  "fullBio": "Dileepa Bandara is an AI systems engineer with experience building agentic applications, production evaluation harnesses, and scalable cloud solutions. He writes about AI architecture on dileepa.dev and maintains open-source tools for developers."
}

### A JPEG portrait. WebP and PNG are unchanged and still preferred in that
# order; this is a third format, not a replacement for either.
PATCH {{baseUrl}}/about
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "images": {
    "profileWebp": "https://res.cloudinary.com/example/profile.webp",
    "profileJpg": "https://res.cloudinary.com/example/profile.jpg",
    "profilePng": "https://res.cloudinary.com/example/profile.png"
  }
}

### Delete it.
DELETE {{baseUrl}}/about
Authorization: Bearer {{accessToken}}

### Writing without a token -> 401 missing_token.
PATCH {{baseUrl}}/about
Content-Type: application/json

{ "tagline": "should not work" }
