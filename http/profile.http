Authorization: Bearer {{accessToken}}

# ================================ tools ================================
# `name` is unique here — a duplicate is a 409, see the failure cases below.

### List. Public callers see published records only.
GET {{baseUrl}}/tools

### With paging. limit is 1..100, offset is >= 0.
GET {{baseUrl}}/tools?limit=5&offset=0

### Unpublished records, which need an admin token to see at all.
GET {{baseUrl}}/tools?published=false
Authorization: Bearer {{accessToken}}

### Create.
# @name createTool
POST {{baseUrl}}/tools
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "FastAPI",
  "logo": {
    "light": "https://res.cloudinary.com/example/logo-light.png",
    "dark": "https://res.cloudinary.com/example/logo-dark.png"
  },
  "order": 5
}

###

@toolId = {{createTool.response.body.$.id}}

### Read one.
GET {{baseUrl}}/tools/{{toolId}}

### Update. Send only what changes.
PATCH {{baseUrl}}/tools/{{toolId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "order": 15 }

### Reorder. One request per drag-and-drop commit, rather than one PATCH per
# row — which is what a list of any length would otherwise cost.
PATCH {{baseUrl}}/tools/order
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "items": [
    { "id": "{{toolId}}", "order": 20 }
  ]
}

### Delete.
DELETE {{baseUrl}}/tools/{{toolId}}
Authorization: Bearer {{accessToken}}

