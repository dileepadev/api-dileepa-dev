{ "current": false, "period": "2023 - 2026" }

### Reorder. One request per drag-and-drop commit, rather than one PATCH per
# row — which is what a list of any length would otherwise cost.
PATCH {{baseUrl}}/communities/order
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "items": [
    { "id": "{{communityId}}", "order": 20 }
  ]
}

### Delete.
DELETE {{baseUrl}}/communities/{{communityId}}
Authorization: Bearer {{accessToken}}

# ================================ videos ================================
# `date` is a free-text string in v1 and stays one. Nothing sorts on it,
# so it was not worth a migration.

### List. Public callers see published records only.
GET {{baseUrl}}/videos

### With paging. limit is 1..100, offset is >= 0.
GET {{baseUrl}}/videos?limit=5&offset=0

### Unpublished records, which need an admin token to see at all.
GET {{baseUrl}}/videos?published=false
Authorization: Bearer {{accessToken}}

### Create.
# @name createVideo
POST {{baseUrl}}/videos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "A talk recording",
  "date": "2026-01-15",
  "link": "https://youtube.com/watch?v=example",
  "thumbnail": "https://img.youtube.com/vi/example/maxresdefault.jpg",
  "order": 10
}

###

@videoId = {{createVideo.response.body.$.id}}

### Read one.
GET {{baseUrl}}/videos/{{videoId}}

### Update. Send only what changes.
PATCH {{baseUrl}}/videos/{{videoId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "A talk recording (remastered)" }

### Reorder. One request per drag-and-drop commit, rather than one PATCH per
# row — which is what a list of any length would otherwise cost.
PATCH {{baseUrl}}/videos/order
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "items": [
    { "id": "{{videoId}}", "order": 20 }
  ]
}

### Delete.
DELETE {{baseUrl}}/videos/{{videoId}}
Authorization: Bearer {{accessToken}}

# ============================= failure cases =============================

### Missing required fields -> 422, listing every field that failed.
POST {{baseUrl}}/tools
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "No logo" }

### A duplicate tool name -> 409 conflict.
POST {{baseUrl}}/tools
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "FastAPI",
  "logo": { "light": "https://example.com/l.svg", "dark": "https://example.com/d.svg" }
}

### limit above the maximum -> 422.
GET {{baseUrl}}/tools?limit=1000

### Unknown id -> 404.
GET {{baseUrl}}/tools/000000000000000000000000

### Writing without a token -> 401 missing_token.
POST {{baseUrl}}/tools
Content-Type: application/json

{ "name": "Should not work" }
