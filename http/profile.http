    "light": "https://res.cloudinary.com/example/logo-light.png",
    "dark": "https://res.cloudinary.com/example/logo-dark.png"
  },
  "order": 10
}

###

@educationId = {{createEducation.response.body.$.id}}

### Read one.
GET {{baseUrl}}/educations/{{educationId}}

### Update. Send only what changes.
PATCH {{baseUrl}}/educations/{{educationId}}
Authorization: Bearer {{accessToken}}
