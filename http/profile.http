# Profile — experiences, educations, tools, communities, videos.
#
# Five resources with no behaviour of their own, so they are one file, the same
# way they are one module in app/routers/profile.py. Each block is identical:
# public list, admin create, read one, update, reorder, delete. That uniformity
# is the point — a resource that needed something different would have its own
# module, and its own file here.
#
# Collection responses are always { items, total, limit, offset }.
# `order` means priority: higher values sort first.

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

###

@accessToken = {{login.response.body.$.access_token}}

# ============================= experiences =============================

### List. Public callers see published records only.
GET {{baseUrl}}/experiences

### With paging. limit is 1..100, offset is >= 0.
GET {{baseUrl}}/experiences?limit=5&offset=0

### Unpublished records, which need an admin token to see at all.
GET {{baseUrl}}/experiences?published=false
Authorization: Bearer {{accessToken}}

### Create.
# @name createExperience
POST {{baseUrl}}/experiences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Software Engineer",
  "company": "Example Ltd",
  "url": "https://example.com",
  "period": "2024 - Present",
  "description": "What the role involved.",
  "technologies": ["Python", "FastAPI", "MongoDB"],
  "logo": {
    "light": "https://res.cloudinary.com/example/logo-light.png",
    "dark": "https://res.cloudinary.com/example/logo-dark.png"
  },
  "order": 10,
  "published": true
}

###

@experienceId = {{createExperience.response.body.$.id}}

### Read one.
GET {{baseUrl}}/experiences/{{experienceId}}

### Update. Send only what changes.
PATCH {{baseUrl}}/experiences/{{experienceId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "description": "A more accurate description." }

### Reorder. One request per drag-and-drop commit, rather than one PATCH per
# row — which is what a list of any length would otherwise cost.
PATCH {{baseUrl}}/experiences/order
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "items": [
    { "id": "{{experienceId}}", "order": 20 }
  ]
}

### Delete.
DELETE {{baseUrl}}/experiences/{{experienceId}}
Authorization: Bearer {{accessToken}}

# ============================== educations ==============================

### List. Public callers see published records only.
GET {{baseUrl}}/educations

### With paging. limit is 1..100, offset is >= 0.
GET {{baseUrl}}/educations?limit=5&offset=0

