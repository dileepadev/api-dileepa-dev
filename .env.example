# Example environment for api.dileepa.dev (v2.0.0, FastAPI).
# Copy to .env and fill in real values. .env is gitignored; never commit one.
#
# In production these are set with `fastapi cloud env set`, and anything
# sensitive with `--secret`. Secrets there are write-only, so keep the
# authoritative copy in a password manager. Changing any of them needs a
# redeploy to take effect.

# --- Application ---------------------------------------------------------
# development | staging | production. The API reference is served at /docs in
# development, rendered by Scalar, and disabled in production along with the
# OpenAPI JSON at /api-json. DOCS_ENABLED overrides that.
ENVIRONMENT=development
PORT=8000
# Used to compose blog canonical URLs.
SITE_URL=https://dileepa.dev
# DOCS_ENABLED=false
# The Scalar bundle the reference page loads. Pin a version, or point it at a
# self-hosted copy; whatever origin is set here is the only one the docs page's
# Content-Security-Policy allows.
# SCALAR_JS_URL=https://cdn.jsdelivr.net/npm/@scalar/api-reference

# --- CORS ----------------------------------------------------------------
# Comma-separated allowlist. Never `*`. Localhost origins are added
# automatically outside production, and Vercel preview hostnames are matched by
# pattern, so neither needs listing here.
CORS_ORIGINS=https://dileepa.dev,https://www.dileepa.dev,https://admin.dileepa.dev,https://links.dileepa.dev

# --- MongoDB -------------------------------------------------------------
# The same cluster and collections the NestJS app uses. No re-seed.
MONGODB_URI=mongodb://localhost:27017/dileepa
# Only needed when the URI has no default database in its path.
# MONGODB_DB=dileepa

# --- Auth ----------------------------------------------------------------
# JWT_SECRET, JWT_ALGORITHM and ACCESS_TOKEN_EXPIRE_MINUTES must match the
# NestJS deployment through the cutover, or every existing session is
# invalidated the moment traffic moves. Generate a new secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cloudinary ----------------------------------------------------------
# The only image backend. Azure Blob Storage is retired.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_ROOT_FOLDER=api-dileepa-dev

# --- Contact form (Resend) -----------------------------------------------
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_sender
CONTACT_EMAIL=contact@dileepa.dev

# --- Blog sync -----------------------------------------------------------
# Machine-to-machine key for POST /blogs/sync, sent as an x-api-key header by
# the blog repo's workflow. Same variable name as v1.
BLOG_SYNC_API_KEY=your_blog_sync_api_key

# --- Rate limits ---------------------------------------------------------
# slowapi notation. The contact form is deliberately tighter.
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CONTACT=3/minute
