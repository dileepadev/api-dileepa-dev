# Example .env file for api.dileepa.dev
# Copy this file to .env and fill in the values as needed

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGINS=https://dileepa.dev,https://www.dileepa.dev,https://dileepa-dev-git-feat-v130-dileepadev-projects.vercel.app

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dileepa

# Other secrets (add as needed)
JWT_SECRET=your_jwt_secret

# Swagger (optional)
SWAGGER_USER=admin
SWAGGER_PASSWORD=your_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend API Key
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_sender_email
CONTACT_EMAIL=your_contact_email

# Blog Sync (used by GitHub Actions to sync blog posts)
BLOG_SYNC_API_KEY=your_blog_sync_api_key