# Production configuration for api.dileepa.dev (v2.0.0, FastAPI).
#
#   cp .env.production.example .env.production
#   ENVIRONMENT=production uv run fastapi run
#
# **The real deployment does not read this file.** FastAPI Cloud holds its own
# configuration, set with `fastapi cloud env set` and `--secret`. Secrets there
# are write-only, so keep the authoritative copy in a password manager, and
# remember that changing one needs a redeploy to take effect.
#
# This file is for running production mode on your own machine — rehearsing a
# release, reproducing a production-only bug. It is complete on its own:
# `ENVIRONMENT=production` loads it and nothing else.
#
# Everything here is checked at startup. The app refuses to boot in production
# with a placeholder JWT_SECRET, a localhost database, a wildcard CORS entry, or
# an empty BLOG_SYNC_API_KEY, and warns about a short signing secret or a
# missing Resend or Cloudinary credential. See app/core/config.py.

# --- Application ---------------------------------------------------------
# Must match the file name, and must also be exported for this file to be the
# one that loads. Disagreeing values make the app refuse to start.
ENVIRONMENT=production
PORT=8000
SITE_URL=https://dileepa.dev

# SCALAR_JS_URL=https://cdn.jsdelivr.net/npm/@scalar/api-reference

# The reference and the OpenAPI JSON are both off in production — the page
# cannot be reached and the spec it reads is not served. This is the v1
# posture, deliberately kept. Leave it alone.
# DOCS_ENABLED=false

# --- CORS ----------------------------------------------------------------
# In production this allowlist is the whole story: localhost origins are no
# longer added for you. Name every real origin. Never `*` — startup rejects it.
CORS_ORIGINS=https://dileepa.dev,https://www.dileepa.dev,https://admin.dileepa.dev,https://links.dileepa.dev

# --- MongoDB -------------------------------------------------------------
# The production cluster and database, which is not the one development writes
# to. A localhost URI here is rejected at startup.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dileepa

# --- Auth ----------------------------------------------------------------
# These three must match the NestJS deployment through the cutover, or every
# existing session is invalidated the moment traffic moves.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cloudinary ----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=api-dileepa-dev

# --- Contact form (Resend) -----------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=contact@dileepa.dev

# --- Blog sync -----------------------------------------------------------
# Required in production: an empty value is rejected at startup, because the
# pipeline would have no way to authenticate.
BLOG_SYNC_API_KEY=

# --- Rate limits ---------------------------------------------------------
# slowapi notation. The contact form is deliberately tighter.
#
# Comments post without review, so RATE_LIMIT_COMMENT is the main thing standing
# between the blog and a spam run. Looser than contact — a reader may
# legitimately reply twice in a conversation — and far tighter than the default.
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CONTACT=3/minute
RATE_LIMIT_COMMENT=6/minute
